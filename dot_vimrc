"Keybinds {{{
"Doesn't save deleted contents to buffer
noremap dd "_dd
"Leader Key set to space (Add custom commands/rebinds using this!)
nnoremap <SPACE> <Nop>
let mapleader=" "
"Set leader down (space down arrow) to open :Lex file explorer !!!Caused
"crashing, disable if continues
nnoremap <leader><Down> :Lex<CR>
"Coc.nvim keybinds {{{
" Use `g<leftarrow>` and `g<rightarrow>` to navigate diagnostics, g<downarrow>
" to show all
nmap <silent><nowait> g<Left> <Plug>(coc-diagnostic-prev)
nmap <silent><nowait> g<Right> <Plug>(coc-diagnostic-next)
nnoremap <silent><nowait> g<Down>  :<C-u>CocList diagnostics<cr>
" GoTo code definition
nmap <silent><nowait> gd <Plug>(coc-definition)
" Manage extensions
nnoremap <silent><nowait> <leader>e  :<C-u>CocList extensions<cr>
" Show commands
nnoremap <silent><nowait> <leader>c  :<C-u>CocList commands<cr>
" Tab to autocomplete,enter to accept, Ctrl-e to cancel(change keybind later)
inoremap <silent><expr> <TAB>
      \ coc#pum#visible() ? coc#pum#next(1) :
      \ CheckBackspace() ? "\<Tab>" :
      \ coc#refresh()
inoremap <expr><S-TAB> coc#pum#visible() ? coc#pum#prev(1) : "\<C-h>"

" Make <CR> to accept selected completion item or notify coc.nvim to format
" <C-g>u breaks current undo, please make your own choice
inoremap <silent><expr> <CR> coc#pum#visible() ? coc#pum#confirm()
                              \: "\<C-g>u\<CR>\<c-r>=coc#on_enter()\<CR>"

function! CheckBackspace() abort
  let col = col('.') - 1
  return !col || getline('.')[col - 1]  =~# '\s'
endfunction
" Use <c-space> to trigger completion
if has('nvim')
  inoremap <silent><expr> <c-space> coc#refresh()
else
  inoremap <silent><expr> <c-@> coc#refresh()
endif
